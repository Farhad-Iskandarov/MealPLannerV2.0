# MealPlanner Server & Android Backend Configuration
# Copy this file to .env and supply your own credentials as needed.
# Secret API keys MUST remain on the server and are never exposed to the mobile client.

PORT=3000
DATABASE_PATH=./data/mealplanner.sqlite
JWT_SECRET=mealplanner-poland-super-secret-jwt-key-change-in-production-2026

# AI Provider Configuration ('gemini' | 'openai' | 'auto')
# When GEMINI_API_KEY or OPENAI_API_KEY is configured, live LLM generation is used
# and validated through the deterministic allergy/diet/budget validator.
# When no key is configured, the deterministic Smart Culinary Engine generates validated plans.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supermarket Live Probe Configuration
# Set to true to allow safe public catalogue metadata probing where permitted by robots.txt/terms.
# Never bypasses authentication, CAPTCHAs, or rate limits.
ENABLE_LIVE_SUPERMARKET_PROBE=true
