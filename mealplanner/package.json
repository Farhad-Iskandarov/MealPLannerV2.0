{
  "name": "mealplanner-android",
  "version": "1.0.0",
  "description": "MealPlanner - Complete AI-Powered Meal Planning & Smart Grocery Shopping Android Application for Poland",
  "private": true,
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:client && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "refresh:biedronka-pl": "tsx scripts/refresh-biedronka-pl.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
